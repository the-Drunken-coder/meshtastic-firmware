      "prepared": 1,
      "running": 2,
      "complete": 4,
      "pending_tx": 16,
      "as_of_incomplete": 32
    },
    "sample_status_bits": {
      "irq_read_succeeded": 1,
      "fifo_flags_read_succeeded": 2,
      "fifo_level_read_succeeded": 4,
      "errors_read_succeeded": 8,
      "sample_available": 16
    },
    "software_state_bits": {
      "is_receiving": 1,
      "rx_offline": 2,
      "irq_attachment_mask": 12,
      "irq_attachment_shift": 2,
      "irq_attachment_encoding": {
        "0": "none",
        "1": "RX callback",
        "2": "TX callback",
        "3": "unknown"
      },
      "irq_attachment_sample_valid": 16
    }
  },
  "validation": {
    "reserved": "all reserved bytes zero; unknown status or software-state bits invalid",
    "state": "prepared; exactly one running/complete; pending count <=16; pending status matches count; as_of flag equals running or pending",
    "sample": "sample_valid matches sample_available; unavailable sample has no success bits and i16 read results INT16_MIN; available results not INT16_MIN and result=0 exactly when respective success bit set",
    "timer": "dispatches <= accepted; late_count <= dispatches; no late_count implies late_sum=max=0; nonzero late_count implies max>0 and sum>=max; active timer has nonzero due_at, inactive has zero",
    "counter_scope": "saturating board-local counters reset with benchmark RESET; exclusive primary pre-send reasons BUSY_TX then IRQ-read failure then RX-active; do not convert counts into RF occupancy",
    "host_bounds": "only correlated responses within the request finite deadline are evidence; stale, malformed, foreign, and parser/reader/write failures invalidate capture",
    "interpretation": "on-demand reads perturb timing; report exact request and observation timestamps; no delivery, PER, capacity or recovery authorization follows from kind7 alone"
  }
}
