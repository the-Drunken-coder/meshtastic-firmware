{
  "name": "w12-pre-send-attribution",
  "version": 1,
  "feature_gate": "MESHTASTIC_W12_BENCHMARK=1",
  "scope": "board_local_diagnostic_not_rf_acceptance",
  "control": {
    "operation": 9,
    "bytes": 32,
    "integer_encoding": "little-endian",
    "layout_authority": "benchmark-protocol.json control fields; op=9",
    "authorization": "decoded PRIVATE_APP, local API or INTERNAL, from=0, getFrom=self, to=self, not MQTT, want_ack=false, pki_encrypted=false, want_response=true",
    "config": "exact matching prepared run, either running or complete; not accepted before START",
    "effects": "read-only snapshot; no FIFO or chip-error clear, RX rearm, TX cancellation, or policy change"
  },
  "reply": {
    "kind": 7,
    "bytes": 233,
    "integer_encoding": "little-endian",
    "identity": "local self PRIVATE_APP reply; request_id matches the control packet ID; header run/source/destination match the request config",
