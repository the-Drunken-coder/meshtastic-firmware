+/**
+  \brief Value-owned status returned by the finite FLRC receive consume seam.
+
+  The structure contains only values copied from the chip. It never borrows
+  RadioLib or FIFO storage and is valid after the consume call returns.
+*/
+struct LR2021FlrcRxPacketStatus {
+  bool irqReadValid = false;
+  bool packetStatusReadValid = false;
+  bool modeReadValid = false;
+  bool cleanupAttempted = false;
+  // The owner must stay offline after a foreign modem result.
+  bool rearmBlocked = false;
+  uint32_t irqFlags = 0;
+  uint16_t packetLength = 0;
+  float rssiAverage = 0.0f;
+  float rssiSync = 0.0f;
+  uint8_t syncWord = 0;
+  uint8_t rawStatus2 = 0;
+  uint8_t mode = 0;
+  bool rearmSafe = false;
+};
+
+/**
+  \brief Value-owned result of bounded FLRC FIFO and IRQ discard.
+
+  FIFO destruction is permitted only after the chip has been checked in
+  STDBY_RC. A false rearmSafe value requires the owner to stop before arming
+  RX again.
+*/
+struct LR2021FlrcRxDiscardStatus {
+  int16_t state = RADIOLIB_ERR_UNKNOWN;
+  uint8_t rawStatus2 = 0;
+  uint8_t mode = 0;
+  uint8_t standbyAttempts = 0;
+  bool cleanupAttempted = false;
+  bool initialStatusValid = false;
+  bool standbyVerified = false;
+  bool fifoCleared = false;
+  bool irqCleared = false;
+  // A fresh packet-type proof failed or found a foreign modem.
+  bool rearmBlocked = false;
+  bool rearmSafe = false;
+};
 
