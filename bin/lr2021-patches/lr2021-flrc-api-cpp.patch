+namespace
+{
+constexpr uint8_t LR2021_STAT2_MODE_MASK = 0x07;
+constexpr uint8_t LR2021_STAT2_MODE_STDBY_RC = 1;
+
+uint8_t lr2021StatusMode(uint8_t stat2)
+{
+  return static_cast<uint8_t>(stat2 & LR2021_STAT2_MODE_MASK);
+}
+
+bool lr2021IsStandbyRc(uint8_t stat2)
+{
+  return lr2021StatusMode(stat2) == LR2021_STAT2_MODE_STDBY_RC;
+}
